# Local .terraform directories
**/.terraform/

# Terraform lock file (keep .terraform.lock.hcl in version control)
# .terraform.lock.hcl

# State files — never commit state
*.tfstate
*.tfstate.*
*.tfstate.backup
errored.tfstate

# Crash log files
crash.log
crash.*.log

# Sensitive variable files
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files (contain sensitive data)
*.tfplan
*.plan

# CLI configuration files
.terraformrc
terraform.rc

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo
